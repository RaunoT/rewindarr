{
  "name": "rewindarr",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build && serwist build",
    "lint": "oxlint",
    "lint:types": "tsc --noEmit",
    "lint:css": "stylelint --cache \"**/*.css\"",
    "lint:all": "pnpm lint && pnpm lint:types && pnpm lint:css && pnpm format:check",
    "lint:all:fix": "oxlint --fix && pnpm lint:types && stylelint --cache --fix \"**/*.css\" && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.1",
    "country-flag-icons": "1.6.20",
    "lodash": "^4.18.1",
    "modern-screenshot": "^4.7.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "next-intl": "^4.15.3",
    "qs": "^6.17.1",
    "react": "19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@saithodev/semantic-release-backmerge": "^4.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@serwist/cli": "^9.5.15",
    "@serwist/next": "^9.5.15",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cz-customizable": "^7.5.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "semantic-release": "^26.0.1",
    "serwist": "^9.5.15",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
